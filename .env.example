# =====================================================================
# 本地密钥与模型配置（**绝不入库**，见 .gitignore）
#
# 用途：集中存放云端模型通道的 API Key 等敏感配置。
# 用法：复制为 .env.local 后填写真实值；或直接在 shell 里 export。
#       .env            —— 占位模板，可入库（本文件不含真实密钥）
#       .env.local      —— 真实值，**必须被 .gitignore 忽略**
#
# PowerShell 6+ 加载方式（本项目一律用 pwsh 7）：
#   Get-Content .env.local | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#     $k, $v = $_ -split '=', 2
#     [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim())
#   }
#
# 或仅对当前会话临时设置：
#   $env:OJ_ZHIPU_API_KEY = '<你的 key>'
# =====================================================================

# ── 智谱 GLM（cloud-zhipu 通道）──────────────────────────────────────
# 控制台：https://open.bigmodel.cn/  →  API Keys
# ⚠️ 赠額/资源包是**按模型绑定**的：glm-4-plus 不在赠送范围，调它会 429
#    {"code":"1113","余额不足或无可用资源包"}。当前通道用 glm-5.3-flash。
OJ_ZHIPU_API_KEY=
OJ_ZHIPU_MODEL=glm-5.3-flash

# ── 云端 DeepSeek（cloud-ds 通道）────────────────────────────────────
OJ_DEEPSEEK_API_KEY=

# ── 通义千问（cloud-qwen 通道）───────────────────────────────────────
OJ_DASHSCOPE_API_KEY=

# ── 服务间运维调用（admin → judge，填写随机令牌，两服务读取同一文件）──
# 未配置时禁止沙箱终止请求；不要把真实值提交到仓库。
OJ_INNER_TOKEN=
