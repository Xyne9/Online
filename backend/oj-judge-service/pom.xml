<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oj</groupId>
        <artifactId>oj-cloud-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>oj-judge-service</artifactId>
    <packaging>jar</packaging>
    <name>oj-judge-service</name>
    <description>判题服务 8083：RabbitMQ 异步判题队列 + Go-Judge 沙箱适配 + 1s 轮询</description>

    <dependencies>
        <dependency>
            <groupId>com.oj</groupId>
            <artifactId>oj-common-core</artifactId>
        </dependency>

        <!--
          oj-common-web：Servlet 公共基座（全局异常处理 / TraceId 过滤 / UserContext /
          MyBatis-Plus 分页拦截器 / MySQL 驱动）。判题服务要落库 judge_submission，必须引入；
          版本由父工程 dependencyManagement 统一锁定，子模块不写 version。
        -->
        <dependency>
            <groupId>com.oj</groupId>
            <artifactId>oj-common-web</artifactId>
        </dependency>

        <!--
          oj-common-api：复用两个内部契约 DTO
            · FailedCaseDiagnosisDTO（GET  /inner/judge/failed-diagnosis）
            · SubmissionCodeDTO      （POST /inner/judge/batch-best-codes）
          判题服务不发起 Feign 调用（题目配置与测试点走同库直连，见 JudgeServiceImpl 类注释），
          因此不需要 @EnableFeignClients。
        -->
        <dependency>
            <groupId>com.oj</groupId>
            <artifactId>oj-common-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 判题队列：spring-boot-starter-amqp（RabbitMQ） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!--
          Redis：3 秒判题防抖锁 oj:judge:lock:{userId}（SETNX）+ 展示号自增 oj:seq:submission。
          用 Spring Boot 官方 starter（不是第三方依赖），版本由 Boot BOM 管理。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
          Day12 新增：交卷后回写最高分要走 TeachingInnerFeignClient（@FeignClient 按服务名发现）。
          Feign 走服务名时必须配 loadbalancer，否则启动期直接
          IllegalStateException: No Feign Client for loadBalancing defined。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.oj.judge.JudgeApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
