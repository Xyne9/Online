<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oj</groupId>
        <artifactId>oj-cloud-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>oj-common-web</artifactId>
    <packaging>jar</packaging>
    <name>oj-common-web</name>
    <description>Servlet 服务公共基座：全局异常处理 / 用户上下文 / MyBatis-Plus / TraceId 过滤</description>

    <!--
      【为什么单独一个模块，而不是塞进 oj-common-core】
      oj-common-core 刻意不依赖 spring-boot-starter-web（否则 WebFlux 网关会因
      classpath 出现 spring-webmvc 直接启动失败）。而下面这些能力全都需要 servlet API：
        · @RestControllerAdvice 全局异常处理
        · OncePerRequestFilter 桥接 traceId
        · MyBatis-Plus 分页拦截器
      所以拆成 oj-common-web，**只由 5 个 Servlet 业务服务依赖，网关绝不依赖**。
    -->
    <dependencies>
        <dependency>
            <groupId>com.oj</groupId>
            <artifactId>oj-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- @Valid 参数校验（登录、建题、提交判题都要用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          MyBatis-Plus：5 个业务服务都要连库，统一在这里引入，服务模块不再各写一遍。
          必须用 spring-boot3-starter 变体（普通 starter 是给 Boot 2 的，
          在 Boot 3 上会因 javax/jakarta 命名空间不匹配而启动失败）。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动：runtime 即可，业务代码不直接引用 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
